---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import categoryOrder from '../../../content/category_order.json';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.filter(post => !post.data.draft).map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Build Category Tree
const allPosts = await getCollection('posts');
const categoryTree = {};

allPosts.forEach(p => {
  if (!p.data.draft && p.data.categories) {
    p.data.categories.forEach(cat => {
      if (!categoryTree[cat]) {
        categoryTree[cat] = [];
      }
      categoryTree[cat].push({
        id: p.id,
        title: p.data.title || p.id
      });
    });
  }
});

const currentCategories = post.data.categories || [];
---

<Layout title={`${post.data.title || post.id} - Yukari's LEAF`} isArticle={true}>
  <div class="post-layout">
    <!-- Left Column: Category Tree & TOC -->
    <aside class="sidebar-left reveal-on-scroll">
      <div class="glass-panel sticky-sidebar" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 2rem;">
        {headings && headings.length > 0 && (
          <div>
            <details open class="sidebar-details">
            <summary class="sidebar-summary">
              TOC
              <svg class="fold-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;" class="toc-list">
              {headings.map(h => (
                <li style={`padding-left: ${(h.depth - 1) * 1}rem;`}>
                  <a href={`#${h.slug}`} style="font-size: 0.85rem; color: var(--color-text-muted); text-decoration: none; transition: color 0.2s; display: block;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--color-text-muted)'">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </div>
      )}

      <div>
        <details open class="sidebar-details">
          <summary class="sidebar-summary">
            INDEX
            <svg class="fold-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.8rem;">
            {Object.entries(categoryTree).sort((a, b) => {
              const indexA = categoryOrder.indexOf(a[0]);
              const indexB = categoryOrder.indexOf(b[0]);
              if (indexA !== -1 && indexB !== -1) return indexA - indexB;
              if (indexA !== -1) return -1;
              if (indexB !== -1) return 1;
              return a[0].localeCompare(b[0], 'zh-CN');
            }).map(([cat, catPosts]) => {
              const isCurrentCategory = currentCategories.includes(cat);
              return (
                <li>
                  <details class="category-details" open={isCurrentCategory ? true : undefined}>
                    <summary class="category-summary">
                      <span class="cat-name">{cat}</span>
                      <span class="cat-count">{catPosts.length}</span>
                    </summary>
                    <ul class="category-posts">
                      {catPosts.map(p => (
                        <li>
                          <a href={`/posts/${p.id}`} style={p.id === post.id ? 'color: var(--color-primary); font-weight: bold;' : ''}>{p.title}</a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              );
            })}
          </ul>
        </details>
      </div>
      </div>
    </aside>

    <!-- Main Content -->
    <article class="post-main" data-pagefind-body>
      <header class="reveal-on-scroll" style="margin-bottom: 3rem; text-align: center;">
        {post.data.categories && post.data.categories.length > 0 && (
          <div style="display: flex; gap: 0.5rem; justify-content: center; margin-bottom: 1rem;">
            {post.data.categories.map((cat: string) => (
              <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-primary); background: var(--color-surface); padding: 0.25rem 0.8rem; border-radius: 6px; font-weight: 500; border: 1px solid var(--color-border); letter-spacing: 0.05em; box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.02);">
                {cat}
              </span>
            ))}
          </div>
        )}
        
        <h1 data-pagefind-meta="title" style="font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1rem; color: var(--color-text); line-height: 1.3; font-weight: 800;">
          {post.data.title || post.id}
        </h1>
        
        {post.data.date && (
          <time style="color: var(--color-text-muted); font-size: 1rem; letter-spacing: 0.05em;">
            {new Date(post.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        )}
      </header>

      <div class="prose glass-panel no-hover reveal-on-scroll" style="padding: 3rem; overflow-wrap: break-word; word-break: break-word;">
        <Content />
      </div>

      <!-- Comments Section -->
      <section class="glass-panel reveal-on-scroll" style="margin-top: 3rem; padding: 2rem;">
        <h3 style="margin-bottom: 1.5rem; font-size: 1.5rem;">Comments</h3>
        <div id="giscus-container"></div>
        <script src="https://giscus.app/client.js"
          data-repo="yukari502/Yukari.online.source"
          data-repo-id="R_kgDORFD2tA"
          data-category="Show and tell"
          data-category-id="DIC_kwDORFD2tM4C_8Bn"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="preferred_color_scheme"
          data-lang="en"
          crossorigin="anonymous"
          async>
        </script>
      </section>
    </article>
  </div>

  <!-- Mobile TOC Button -->
  <button id="mobile-toc-btn" class="mobile-toc-btn glass-panel" aria-label="Toggle Index">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
  </button>
  
  <!-- Mobile Overlay -->
  <div id="mobile-overlay" class="mobile-overlay"></div>
  
  <script is:inline>
    const setupMobileTOC = () => {
      const btn = document.getElementById('mobile-toc-btn');
      const sidebar = document.querySelector('.sidebar-left');
      const overlay = document.getElementById('mobile-overlay');

      if (btn && sidebar && overlay) {
        const toggle = () => {
          sidebar.classList.toggle('mobile-open');
          overlay.classList.toggle('active');
          document.body.style.overflow = sidebar.classList.contains('mobile-open') ? 'hidden' : '';
        };
        
        // Replace to avoid duplicate listeners on client-side routing
        const newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);
        newBtn.addEventListener('click', toggle);

        const newOverlay = overlay.cloneNode(true);
        overlay.parentNode.replaceChild(newOverlay, overlay);
        newOverlay.addEventListener('click', toggle);

        // Close when clicking a TOC link
        const links = sidebar.querySelectorAll('a');
        links.forEach(link => {
          link.addEventListener('click', () => {
            sidebar.classList.remove('mobile-open');
            newOverlay.classList.remove('active');
            document.body.style.overflow = '';
          });
        });
      }
    };
    document.addEventListener('astro:page-load', setupMobileTOC);
  </script>
</Layout>

<style>
  .post-layout {
    display: grid;
    /* Two columns: Left Index (280px), Right Main Content (1fr) */
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 3rem;
    width: 95vw;
    margin: 0 auto;
    padding-top: 8rem;
  }

  .post-main {
    width: 100%;
    max-width: 80ch;
    justify-self: center;
  }

  .sticky-sidebar {
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }

  /* Custom Scrollbar for Sidebar */
  .sticky-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .sticky-sidebar::-webkit-scrollbar-thumb {
    background: var(--color-surface-hover);
    border-radius: 4px;
  }

  /* Sidebar Details (Foldable blocks) */
  .sidebar-summary {
    font-size: 1.2rem;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    outline: none;
    transition: color 0.2s;
  }
  .sidebar-summary::-webkit-details-marker {
    display: none;
  }
  .sidebar-summary:hover {
    color: var(--color-primary);
  }
  .fold-icon {
    transition: transform 0.3s ease;
  }
  .sidebar-details:not([open]) .fold-icon {
    transform: rotate(-90deg);
  }
  .sidebar-details:not([open]) .sidebar-summary {
    margin-bottom: 0;
    border-bottom: none;
  }
  .mobile-toc-btn {
    display: none;
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    z-index: 999;
    padding: 0;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    /* Prevent default active scaling that makes it slip */
    transform: none !important;
  }
  
  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 98;
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  
  .mobile-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Mobile Responsive */
  @media (max-width: 1200px) {
    .post-layout {
      grid-template-columns: 250px minmax(0, 1fr);
      width: 95vw;
    }
  }

  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr;
      width: 100vw;
      padding: 8rem 1rem 2rem 1rem;
    }
    .sidebar-left {
      /* Mobile Drawer Mode */
      position: fixed;
      top: 0;
      left: 0;
      width: 80vw;
      max-width: 320px;
      height: 100vh;
      z-index: 100;
      transform: translateX(-100%);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      background: var(--color-surface);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid var(--color-border);
      box-shadow: 4px 0 30px rgba(0,0,0,0.3);
    }
    .sidebar-left.mobile-open {
      transform: translateX(0);
    }
    .sticky-sidebar {
      position: relative;
      top: 0;
      height: 100%;
      max-height: 100vh;
      border-radius: 0;
      border: none;
      box-shadow: none;
      background: transparent;
      padding-top: 4rem !important; /* Spacing for top */
    }
    .mobile-toc-btn {
      display: flex;
    }
    .mobile-overlay {
      display: block;
    }
    .prose.glass-panel {
      padding: 1.5rem;
    }
  }
</style>
