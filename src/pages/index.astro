---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import categoryOrder from '../../content/category_order.json';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date || new Date()).getTime() - new Date(a.data.date || new Date()).getTime());

// Category Tree for Right Sidebar (Accordion)
const categoryTree = {};
sortedPosts.forEach(post => {
  if (post.data.categories) {
    post.data.categories.forEach(cat => {
      if (!categoryTree[cat]) {
        categoryTree[cat] = [];
      }
      categoryTree[cat].push({
        id: post.id,
        title: post.data.title || post.id
      });
    });
  }
});

const categoriesList = Object.entries(categoryTree).sort((a, b) => {
  const indexA = categoryOrder.indexOf(a[0]);
  const indexB = categoryOrder.indexOf(b[0]);
  
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  
  return a[0].localeCompare(b[0], 'zh-CN');
});

// Pass initial posts and the rest to client script
const INITIAL_LOAD = 5;
const initialPosts = sortedPosts.slice(0, INITIAL_LOAD);

// Serialize necessary data for client-side infinite scroll
const serializedPosts = sortedPosts.map(post => ({
  id: post.id,
  title: post.data.title || post.id,
  summary: post.data.summary || post.data.description || 'No summary provided.',
  date: post.data.date ? new Date(post.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' }) : '',
  categories: post.data.categories || []
}));
---

<Layout title="Yukari's LEAF - Personal Blog" hideNavOnLoad={true}>
  <!-- Dynamic Hero Banner -->
  <section class="hero-section" id="hero">
    <div class="hero-bg"></div>
    <div class="hero-content animate-in">
      <h1 class="hero-title">Yukari's LEAF</h1>
      <p class="hero-subtitle">A leaf from the internet</p>
    </div>
    
    <!-- Scroll Down Indicator -->
    <div class="scroll-indicator animate-in delay-3">
      <div class="mouse">
        <div class="wheel"></div>
      </div>
      <div class="arrow"></div>
      <div class="arrow"></div>
      <div class="arrow"></div>
    </div>
  </section>

  <!-- Three Column Layout Area -->
  <div class="container main-layout">
    
    <!-- Left Column: Personal Info (Sticky) -->
    <aside class="sidebar-left animate-in delay-1">
      <div class="glass-panel profile-card sticky-sidebar">
        <div class="avatar-container">
          <img src="/Pic/avatar.png" alt="Yukari" class="avatar" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 100\'><rect width=\'100\' height=\'100\' fill=\'%2310b981\'/><text x=\'50\' y=\'50\' dominant-baseline=\'middle\' text-anchor=\'middle\' font-size=\'40\' fill=\'white\' font-family=\'sans-serif\'>Y</text></svg>'" />
        </div>
        <h2 class="profile-name">Yukari</h2>
        <p class="profile-bio">一个爱玩、爱技术、爱二次元、喜欢折腾的玩家。</p>
        <div class="profile-socials">
          <a href="https://github.com/yukari502" target="_blank" class="social-link">GitHub</a>
          <a href="/about" class="social-link">About Me</a>
        </div>
      </div>
    </aside>

    <!-- Center Column: Infinite Scroll Posts -->
    <main class="feed-center animate-in delay-2">
      <h2 style="font-size: 2rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border);">Recent Thoughts</h2>
      
      <div id="posts-container" style="display: flex; flex-direction: column; gap: 2rem;">
        {/* Initial Rendered Posts for SEO and fast loading */}
        {initialPosts.map(post => (
          <a href={`/posts/${post.id}`} class="glass-panel post-card" style="display: block; text-decoration: none;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
              <div style="flex: 1; min-width: 250px;">
                <h3 style="font-size: 1.5rem; margin-bottom: 0.8rem; color: var(--color-text); line-height: 1.3;">{post.data.title || post.id}</h3>
                <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.6;">
                  {post.data.summary || post.data.description || 'No summary provided.'}
                </p>
              </div>
              {post.data.date && (
                <div style="background: var(--color-surface-hover); color: var(--color-primary); padding: 0.4rem 0.8rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; white-space: nowrap; border: 1px solid var(--color-border);">
                  {new Date(post.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
                </div>
              )}
            </div>
            {post.data.categories && post.data.categories.length > 0 && (
              <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem; flex-wrap: wrap;">
                {post.data.categories.map(cat => (
                  <span style="font-size: 0.8rem; color: var(--color-text-muted); background: rgba(0,0,0,0.2); padding: 0.3rem 0.8rem; border-radius: 100px; border: 1px solid var(--color-border);">
                    #{cat}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
      
      <!-- Infinite Scroll Trigger/Loader -->
      <div id="load-more-trigger" style="text-align: center; padding: 3rem 0; color: var(--color-text-muted);">
        <div class="loader" id="loader-spinner">加载中...</div>
        <div id="no-more-text" style="display: none; font-size: 0.9rem;">没有更多文章了</div>
      </div>
    </main>

    <!-- Right Column: Categories (Sticky) -->
    <aside class="sidebar-right animate-in delay-3">
      <div class="glass-panel sticky-sidebar" style="padding: 1.5rem;">
        <h3 style="font-size: 1.2rem; margin-bottom: 1.5rem; color: var(--color-text); border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Index</h3>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.8rem;">
          {categoriesList.map(([cat, catPosts]) => (
            <li>
              <details class="category-details">
                <summary class="category-summary">
                  <span class="cat-name">{cat}</span>
                  <span class="cat-count">{catPosts.length}</span>
                </summary>
                <ul class="category-posts">
                  {catPosts.map(p => (
                    <li>
                      <a href={`/posts/${p.id}`}>{p.title}</a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </aside>

  </div>

</Layout>

<style>
  /* Hero Section Styles */
  .hero-section {
    position: relative;
    height: 70vh;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: -6rem; /* Offset for nav */
    margin-bottom: 4rem;
  }
  
  /* Fallback or actual background image for hero */
  .hero-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    /* User's hero image with a fallback gradient */
    background-color: #1e293b;
    background-image: url('/Pic/hero.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: -2;
    transition: transform 0.1s ease-out;
  }
  
  /* Overlay to ensure text readability */
  .hero-section::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(15,17,21,0.4) 0%, var(--color-bg) 100%);
    z-index: -1;
  }

  .hero-content {
    text-align: center;
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
    color: #ffffff;
    text-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 3vw, 1.5rem);
    color: rgba(255,255,255,0.8);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* 3-Column Layout */
  .main-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr) 280px;
    gap: 3rem;
    width: 100%;
  }

  .sticky-sidebar {
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }
  
  .sticky-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .sticky-sidebar::-webkit-scrollbar-thumb {
    background: var(--color-surface-hover);
    border-radius: 4px;
  }

  /* Profile Card */
  .profile-card {
    text-align: center;
    padding: 2rem 1.5rem;
  }
  .avatar-container {
    width: 100px;
    height: 100px;
    margin: 0 auto 1.5rem auto;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--color-surface-hover);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }
  .avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile-name {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }
  .profile-bio {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }
  .profile-socials {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .social-link {
    display: block;
    padding: 0.6rem;
    background: var(--color-surface-hover);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.2s, color 0.2s;
  }
  .social-link:hover {
    background: var(--color-primary);
    color: #fff;
  }

  /* Post Card Specific */
  .post-card {
    padding: 2rem;
  }

  /* Scroll Indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0.8;
  }
  .mouse {
    width: 26px;
    height: 42px;
    border: 2px solid rgba(255,255,255,0.6);
    border-radius: 15px;
    position: relative;
    margin-bottom: 5px;
  }
  .wheel {
    width: 4px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 2px;
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    animation: scroll 1.5s infinite;
  }
  .arrow {
    width: 10px;
    height: 10px;
    border-right: 2px solid rgba(255,255,255,0.6);
    border-bottom: 2px solid rgba(255,255,255,0.6);
    transform: rotate(45deg);
    margin-top: -4px;
    animation: arrow-down 1.5s infinite;
  }
  .arrow:nth-child(2) { animation-delay: -0.2s; }
  .arrow:nth-child(3) { animation-delay: -0.4s; }

  @keyframes scroll {
    0% { transform: translate(-50%, 0); opacity: 1; }
    100% { transform: translate(-50%, 15px); opacity: 0; }
  }
  @keyframes arrow-down {
    0% { opacity: 0; transform: rotate(45deg) translate(-5px, -5px); }
    50% { opacity: 1; }
    100% { opacity: 0; transform: rotate(45deg) translate(5px, 5px); }
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .main-layout {
      grid-template-columns: 1fr;
    }
    .sidebar-left, .sidebar-right {
      position: static;
    }
    .hero-section {
      height: 50vh;
    }
  }
</style>

<script is:inline define:vars={{ serializedPosts, INITIAL_LOAD }}>
  // Parallax Effect for Hero
  const heroBg = document.querySelector('.hero-bg');
  const heroContent = document.querySelector('.hero-content');
  
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    if (scrollY < window.innerHeight && heroBg) {
      heroBg.style.transform = `translateY(${scrollY * 0.4}px)`;
      heroContent.style.transform = `translateY(${scrollY * 0.2}px)`;
      heroContent.style.opacity = 1 - (scrollY / 400);
    }
  });

  // Infinite Scroll Logic
  const container = document.getElementById('posts-container');
  const trigger = document.getElementById('load-more-trigger');
  const loader = document.getElementById('loader-spinner');
  const noMoreText = document.getElementById('no-more-text');
  
  let currentIndex = INITIAL_LOAD;
  const LOAD_AMOUNT = 5;

  const renderPost = (post) => {
    const a = document.createElement('a');
    a.href = `/posts/${post.id}`;
    a.className = 'glass-panel post-card';
    a.style.display = 'block';
    a.style.textDecoration = 'none';
    
    // Animate new items
    a.style.opacity = '0';
    a.style.transform = 'translateY(20px)';
    a.style.transition = 'opacity 0.5s ease, transform 0.5s ease';

    let tagsHtml = '';
    if (post.categories && post.categories.length > 0) {
      tagsHtml = `
        <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem; flex-wrap: wrap;">
          ${post.categories.map(cat => `
            <span style="font-size: 0.8rem; color: var(--color-text-muted); background: rgba(0,0,0,0.2); padding: 0.3rem 0.8rem; border-radius: 100px; border: 1px solid var(--color-border);">
              #${cat}
            </span>
          `).join('')}
        </div>
      `;
    }

    let dateHtml = '';
    if (post.date) {
      dateHtml = `
        <div style="background: var(--color-surface-hover); color: var(--color-primary); padding: 0.4rem 0.8rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; white-space: nowrap; border: 1px solid var(--color-border);">
          ${post.date}
        </div>
      `;
    }

    a.innerHTML = `
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div style="flex: 1; min-width: 250px;">
          <h3 style="font-size: 1.5rem; margin-bottom: 0.8rem; color: var(--color-text); line-height: 1.3;">${post.title}</h3>
          <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.6;">
            ${post.summary}
          </p>
        </div>
        ${dateHtml}
      </div>
      ${tagsHtml}
    `;

    container.appendChild(a);
    
    // Trigger reflow for animation
    setTimeout(() => {
      a.style.opacity = '1';
      a.style.transform = 'translateY(0)';
    }, 50);
  };

  const loadMorePosts = () => {
    if (currentIndex >= serializedPosts.length) {
      loader.style.display = 'none';
      noMoreText.style.display = 'block';
      return;
    }
    
    loader.style.display = 'block';
    
    // Simulate slight network delay for better UX feel
    setTimeout(() => {
      const nextBatch = serializedPosts.slice(currentIndex, currentIndex + LOAD_AMOUNT);
      nextBatch.forEach(renderPost);
      currentIndex += LOAD_AMOUNT;
      
      if (currentIndex >= serializedPosts.length) {
        loader.style.display = 'none';
        noMoreText.style.display = 'block';
      }
    }, 400);
  };

  // Intersection Observer for infinite scroll
  if (trigger && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        loadMorePosts();
      }
    }, { rootMargin: '0px 0px 200px 0px' });
    
    observer.observe(trigger);
  }
</script>
