---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Me - Yukari's LEAF">
  <!-- Spacer to account for the fixed nav bar -->
  <div style="height: 120px;"></div>

  <div class="container" style="max-width: 800px; margin: 0 auto; padding: 2rem;">
    <div class="glass-panel reveal-on-scroll" style="padding: 3rem; border-radius: 20px; text-align: center;">
      <!-- Profile Image -->
      <img 
        src="https://avatars.githubusercontent.com/u/1234567?v=4" 
        alt="Avatar" 
        style="width: 150px; height: 150px; border-radius: 50%; border: 4px solid var(--color-primary); margin-bottom: 1.5rem; object-fit: cover;"
        onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 100\'><circle cx=\'50\' cy=\'50\' r=\'50\' fill=\'%23555\'/></svg>'"
      />
      
      <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem; font-weight: 700;">Yukari</h1>
      <p style="font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: 2rem;">Tech Enthusiast | Developer | Explorer</p>

      <div style="text-align: left; line-height: 1.8; color: var(--color-text); font-size: 1.05rem;">
        <p style="margin-bottom: 1rem;">
          Hello! Welcome to <strong>Yukari's LEAF</strong>. This is my personal corner of the internet where I document my tech journey, coding experiments, and bits of daily life.
        </p>
        <p style="margin-bottom: 1rem;">
          I have a passion for creating beautiful, high-performance web experiences. This blog is built from the ground up using Astro, exploring the boundaries of CSS, native web APIs, and modern frontend architecture.
        </p>
        <p>
          Feel free to explore the archives, read my latest posts, or get in touch!
        </p>
      </div>

      <div style="margin-top: 3rem; display: flex; justify-content: center; gap: 1rem;">
        <a href="/" class="button">Back to Home</a>
        <a href="https://github.com/" target="_blank" class="button button-outline">GitHub</a>
      </div>
    </div>
  </div>

  <style>
    .button {
      display: inline-block;
      padding: 0.8rem 1.5rem;
      border-radius: 50px;
      background: var(--color-primary);
      color: white;
      text-decoration: none;
      font-weight: 600;
      transition: transform 0.2s, box-shadow 0.2s;
      border: 2px solid var(--color-primary);
    }

    .button:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(var(--color-primary-rgb), 0.4);
    }

    .button-outline {
      background: transparent;
      color: var(--color-primary);
    }
  </style>
</Layout>
