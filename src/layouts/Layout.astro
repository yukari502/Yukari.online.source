---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export interface Props {
	title: string;
	hideNavOnLoad?: boolean;
}

const { title, hideNavOnLoad = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Yukari's LEAF - Personal Blog">
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Preconnect to Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=M+PLUS+1+Code:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
		
		<!-- KaTeX Stylesheet for Math Support -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsEw426118w3Ovij5vaO70J0rO0BOHa4Q6f7uNiPjZ7HlT1N6+fF2X9J7/" crossorigin="anonymous">
		
		<ClientRouter />

		<!-- Inline script to prevent FOUC for dark mode -->
		<script is:inline>
			const initTheme = () => {
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: light)').matches) {
					return 'light';
				}
				return 'dark';
			})();

			const setTheme = (t) => {
				document.documentElement.setAttribute('data-theme', t);
				window.localStorage.setItem('theme', t);
			};
			setTheme(theme);
		};
		
		initTheme();
		document.addEventListener('astro:after-swap', initTheme);
	</script>
	</head>
	<body>
    <!-- Premium Navigation Bar -->
    <nav id="main-nav" class={`nav-glass no-hover ${hideNavOnLoad ? 'nav-hidden' : ''}`} style="position: fixed; top: 1rem; left: 50%; transform: translateX(-50%); width: calc(100% - 2rem); max-width: 1200px; padding: 1rem 2rem; z-index: 50; display: flex; justify-content: space-between; align-items: center; border-radius: 100px; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease, background 0.4s, border-color 0.4s, box-shadow 0.4s;">
      <a href="/" style="font-weight: 900; font-size: 1.6rem; letter-spacing: -0.05em; color: var(--color-text); text-decoration: none; display: flex; align-items: baseline;">YUKARI<span style="color: var(--color-primary); font-size: 1.6rem;">.LEAF</span></a>
      <div style="display: flex; align-items: center; gap: 2rem; font-size: 0.95rem; font-weight: 500;">
        <a href="/">Home</a>
        <a href="/posts">Archives</a>
		
		<!-- Theme Toggle Button -->
		<button id="themeToggle" aria-label="Toggle Theme" style="background: transparent; border: none; cursor: pointer; color: var(--color-text); display: flex; align-items: center; justify-content: center; padding: 0.5rem; border-radius: 50%; transition: background 0.3s ease;">
			<svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
			<svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
		</button>
      </div>
    </nav>

    <!-- Main Content Area -->
	<main style="min-height: 100vh;">
		<slot />
	</main>

    <!-- Footer -->
    <footer style="text-align: center; padding: 2rem; margin-top: 4rem; color: var(--color-text-muted); font-size: 0.9rem;">
      <p>&copy; {new Date().getFullYear()} Yukari. All rights reserved.</p>
    </footer>

	<style is:global>
		/* Hide nav class */
		.nav-hidden {
			transform: translate(-50%, -150%) !important;
			opacity: 0;
			pointer-events: none;
		}
		
		/* Nav specific liquid glass */
		.nav-glass {
			/* Crop the distorted ::before layer to the smooth rounded borders */
			overflow: hidden;
			
			border: 1px solid rgba(255, 255, 255, 0.05);
			border-top: 1px solid rgba(255, 255, 255, 0.15);
			border-bottom: 1px solid rgba(0, 0, 0, 0.3);
			
			box-shadow: 
				inset 0 1px 1px rgba(255, 255, 255, 0.15),
				inset 0 -1px 1px rgba(0, 0, 0, 0.2),
				0 8px 32px 0 rgba(0, 0, 0, 0.3);
		}
		
		/* 1. The distortion layer - isolates backdrop filtering and SVG displacement */
		.nav-glass::before {
			content: "";
			position: absolute;
			/* Expand bounds so strong displacement doesn't pull in transparent edges */
			inset: -30px;
			z-index: -2;
			/* Capture the backdrop and apply basic blur/saturation */
			backdrop-filter: blur(6px) saturate(150%);
			-webkit-backdrop-filter: blur(6px) saturate(150%);
			/* Displace the captured backdrop using SVG filter */
			filter: url(#liquid-glass);
			isolation: isolate;
		}

		/* 2. The tint layer - smooth overlay that is NOT distorted */
		.nav-glass::after {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			border-radius: inherit;
			background: linear-gradient(135deg, rgba(30, 38, 52, 0.4) 0%, rgba(11, 14, 20, 0.1) 100%);
		}

		[data-theme='light'] .nav-glass::after {
			background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.15) 100%);
		}
		
		[data-theme='light'] .nav-glass {
			border: 1px solid rgba(0, 0, 0, 0.05);
			border-top: 1px solid rgba(255, 255, 255, 0.6);
			border-bottom: 1px solid rgba(0, 0, 0, 0.1);
			box-shadow: 
				inset 0 1px 1px rgba(255, 255, 255, 0.4),
				inset 0 -1px 1px rgba(0, 0, 0, 0.05),
				0 8px 32px 0 rgba(0, 0, 0, 0.1);
		}
	</style>

	<script>
		const setupInteractions = () => {
			// Theme Toggle Logic
			const themeToggle = document.getElementById('themeToggle');
			const sunIcon = document.getElementById('sun-icon');
			const moonIcon = document.getElementById('moon-icon');

			const updateIcons = (isLight) => {
				if (isLight) {
					sunIcon.style.display = 'none';
					moonIcon.style.display = 'block';
				} else {
					sunIcon.style.display = 'block';
					moonIcon.style.display = 'none';
				}
			};

			const currentTheme = document.documentElement.getAttribute('data-theme');
			if (sunIcon && moonIcon) {
				updateIcons(currentTheme === 'light');
			}

			// Clean up old listener if it exists from previous page load
			const newToggle = themeToggle?.cloneNode(true);
			if (themeToggle && newToggle) {
				themeToggle.parentNode.replaceChild(newToggle, themeToggle);
				newToggle.addEventListener('click', () => {
					const isLight = document.documentElement.getAttribute('data-theme') === 'light';
					const newTheme = isLight ? 'dark' : 'light';
					document.documentElement.setAttribute('data-theme', newTheme);
					localStorage.setItem('theme', newTheme);
					updateIcons(newTheme === 'light');
				});
			}

			// Nav scroll logic
			const nav = document.getElementById('main-nav');
			if (nav) {
				let lastScrollY = window.scrollY;
				const onScroll = () => {
					const currentScrollY = window.scrollY;
					const hero = document.querySelector('.hero-section');
					// If hero exists, keep nav hidden until scrolled past 80vh
					const heroHeight = hero ? window.innerHeight * 0.8 : 0;
					
					if (hero && currentScrollY < heroHeight) {
						// On hero screen, hide nav
						nav.classList.add('nav-hidden');
					} else if (!hero && currentScrollY <= 50) {
						// Normal page at top, show nav
						nav.classList.remove('nav-hidden');
					} else if (currentScrollY > lastScrollY && currentScrollY > 50) {
						// Scrolling down, hide
						nav.classList.add('nav-hidden');
					} else {
						// Scrolling up, show
						nav.classList.remove('nav-hidden');
					}
					lastScrollY = currentScrollY;
				};
				window.addEventListener('scroll', onScroll, { passive: true });
				// Delay initial call slightly to ensure DOM is ready
				setTimeout(onScroll, 50);
			}

			// Setup Global Reveal Observer for fluid scrolling (Wabi-sabi Flow)
			if ('IntersectionObserver' in window) {
				const scrollObserver = new IntersectionObserver((entries, observer) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							// Slight stagger effect if multiple elements appear at once
							setTimeout(() => {
								entry.target.classList.add('reveal-visible');
							}, Math.random() * 100);
							// Only reveal once
							observer.unobserve(entry.target);
						}
					});
				}, {
					rootMargin: '0px 0px -5% 0px', 
					threshold: 0.02
				});

				document.querySelectorAll('.reveal-on-scroll').forEach(el => {
					scrollObserver.observe(el);
				});
				
				// Expose for dynamically added elements (like infinite scroll)
				window.scrollObserver = scrollObserver;
			}
		};

		// Run on initial load and after every page swap
		document.addEventListener('astro:page-load', setupInteractions);
	</script>

	<!-- Mermaid support -->
	<script type="module" is:inline>
		import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
		
		document.addEventListener('astro:page-load', async () => {
			const theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'default' : 'dark';
			mermaid.initialize({ startOnLoad: false, theme });
			
			// Find Astro's standard mermaid markdown output
			const mermaidBlocks = document.querySelectorAll('pre.language-mermaid, pre.astro-code[data-language="mermaid"], div.mermaid');
			
			if (mermaidBlocks.length > 0) {
				mermaidBlocks.forEach((block) => {
					// If it's a pre/code block generated by markdown, extract the text and turn it into a div
					if (block.tagName.toLowerCase() === 'pre') {
						const div = document.createElement('div');
						div.className = 'mermaid';
						div.style.textAlign = 'center'; // Center the flowchart
						div.textContent = block.textContent;
						block.parentNode.replaceChild(div, block);
					}
				});
				try {
					await mermaid.run({ querySelector: '.mermaid' });
				} catch (e) {
					console.error('Mermaid render error', e);
				}
			}
		});
	</script>

	<!-- Native SVG Procedural Liquid Glass Filter -->
	<svg style="position: absolute; width: 0; height: 0; pointer-events: none;" aria-hidden="true">
		<filter id="liquid-glass" x="0%" y="0%" width="100%" height="100%">
			<!-- Large, smooth noise waves like thick glass -->
			<feTurbulence type="fractalNoise" baseFrequency="0.008 0.008" numOctaves="2" seed="92" result="noise" />
			<feGaussianBlur in="noise" stdDeviation="2" result="blurredNoise" />
			<!-- Strong displacement for crystalline refraction -->
			<feDisplacementMap 
				in="SourceGraphic" 
				in2="blurredNoise" 
				scale="70" 
				xChannelSelector="R" 
				yChannelSelector="G" />
		</filter>
	</svg>
	</body>
</html>
